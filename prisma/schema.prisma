generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Categories (3-level tree) ────────────────────────────────────────────────

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String
  level     Int        // 1 = top, 2 = sub, 3 = leaf
  parentId  Int?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products    Product[]
  stockItems  StockItem[] @relation("StockItemCategory")
  createdAt   DateTime   @default(now())

  @@unique([name, parentId])
  @@index([parentId])
  @@index([level])
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id          Int      @id             // source ID from donballon.ru
  name        String                   // Описание для анонса
  description String?                  // full HTML description
  price       Decimal  @db.Decimal(10, 2)
  salePrice   Decimal? @db.Decimal(10, 2)
  vatRate     String?

  imageUrl  String?
  images    String[] // additional product images (beyond the head imageUrl)
  videoUrl  String?

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  collection String?
  holidays   String[]  // e.g. ["Новый Год", "День Рождения"]

  model     String?
  material  String?
  shade     String?
  color     String?
  colorGroup String?
  sizeInches String?
  weight    String?

  minQuantity     Int  @default(1)
  unitsPerPackage Int?
  unitsPerBox     Int?

  barcode         String?
  manufacturer    String?
  countryOfOrigin String?

  isActive            Boolean   @default(true)
  expectedRestockDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([colorGroup])
  @@index([isActive])
  @@index([price])
  @@index([manufacturer])
  @@index([salePrice])
}

// ─── Sharmaster warehouse stock ───────────────────────────────────────────────

model StockItem {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  fullName   String?
  article    String?
  barcode    String?
  brand      String?
  sizeInches String?
  packQty    Int?     // количество шаров в упаковке
  stock      Int      @default(0)
  pricePerPc Decimal  @db.Decimal(10, 2)
  imageUrl   String?
  images     String[]
  productId  Int?
  onSale      Boolean  @default(false)
  salePercent Int?

  categoryId Int?
  category   Category? @relation("StockItemCategory", fields: [categoryId], references: [id])

  isNew        Boolean  @default(false)
  isNewPending Boolean  @default(false) // "Ожидайте поступления" — pre-arrival новинка
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  likes        Like[]

  @@index([stock])
  @@index([brand])
  @@index([pricePerPc])
  @@index([article])
  @@index([categoryId])
  @@index([onSale])
  @@index([isNew])
  @@index([isNewPending])
  @@index([createdAt])
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  password  String   // bcrypt hash — never stored in plaintext
  role      String   @default("user") // "user" | "admin"
  createdAt DateTime @default(now())
  orders    Order[]
  sessions  Session[]
  likes     Like[]
  resetTokens PasswordResetToken[]

  // Server-side mirror of the localStorage cart, synced only for logged-in
  // users — survives a cleared browser/new device, and lets admin see what's
  // sitting in a customer's cart. Null/empty until they add something while
  // logged in. Shape: CartItem[] from context/CartContext.tsx.
  cart      Json?
  cartUpdatedAt DateTime?

  // Server-side mirror of active starter-kit bundles in the cart (localStorage
  // key "sharmaster_cart_kits" — see context/CartContext.tsx). Kept separate
  // from `cart` so every existing reader of that field (admin Carts tab, 1C
  // export, etc.) keeps working unchanged. Shape: CartKit[].
  cartKits      Json?
  cartKitsUpdatedAt DateTime?

  @@index([email])
}

// Избранное залогиненного пользователя. Гости хранят лайки в localStorage
// (только ID) и сливают их сюда при входе — см. context/LikesContext.tsx.
//
// Surrogate `id` PK (not a composite key) because a user needs to be able to
// hold both a legacy stockItemId-row and a new onecStockItemId-row during the
// storefront cutover — exactly one of the two FKs is set per row, enforced by
// Like_exactly_one_item_chk (see migration 20260725010000_add_onec_stock_item_id).
model Like {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockItemId     Int?
  stockItem       StockItem?     @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  onecStockItemId Int?
  onecStockItem   OnecStockItem? @relation(fields: [onecStockItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@unique([userId, stockItemId])
  @@unique([userId, onecStockItemId])
  @@index([stockItemId])
  @@index([onecStockItemId])
}

// Server-side session record. The JWT's `jti` claim references the id here —
// deleting the row revokes the token immediately, before its signature expires.
model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

// One-time link sent by email to let a user set a new password. Only the
// sha256 hash of the raw token is stored — like the password itself, the
// usable secret never sits in the DB in a form a leak could replay.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id           Int         @id @default(autoincrement())
  userId       Int?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName String
  phone        String
  address      String
  // Customer-declared delivery region, collected at checkout: "astana" |
  // "other" — drives the 30 000 ₸ minimum-order rule for out-of-town/foreign
  // customers in app/order/actions.ts. Nullable — orders placed before this
  // field existed have no value.
  deliveryZone String?
  total        Decimal     @db.Decimal(10, 2)
  status       String      @default("Принят")
  createdAt    DateTime    @default(now())
  items        OrderItem[]

  // 1C sale exchange: query stamps onecQueuedAt when the order is handed to 1C,
  // the follow-up mode=success stamps onecExportedAt. Orders with a NULL
  // onecExportedAt are (re)sent on the next exchange, so a failed cycle retries.
  onecQueuedAt   DateTime?
  onecExportedAt DateTime?

  @@index([userId])
  @@index([phone])
  @@index([createdAt])
  @@index([onecExportedAt])
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItemId     Int?
  onecStockItemId Int?
  name            String
  qty             Int
  price           Decimal @db.Decimal(10, 2)

  // Set only for a line that came from a Kit's fixed composition (see Kit/KitItem
  // below) — never set by ordinary cart checkout. kitName is denormalized so the
  // order/Excel/Telegram views can label the line without an extra join, and stays
  // readable even if the Kit is later renamed or deleted (onDelete: SetNull).
  kitId   Int?
  kit     Kit?    @relation(fields: [kitId], references: [id], onDelete: SetNull)
  kitName String?

  @@index([orderId])
  @@index([kitId])
}

// ─── Starter kits ("Набор для новичков") ──────────────────────────────────────
// A fixed-price bundle of OnecStockItem lines. Composition is set once by an
// admin/script (see scripts/_seed-kit-*.ts) and never edited from the storefront
// — the cart enforces that a bundle's locked items can't be removed individually,
// only the whole bundle can be declined (see context/CartContext.tsx's
// addKit/removeKit and app/kits/[slug]/page.tsx).
model Kit {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  // Flat price charged for the whole bundle regardless of the composition's real
  // sum — e.g. "Набор для новичков №1" is always exactly 100 000 ₸, never
  // discounted (see lib/discounts.ts usage in context/CartContext.tsx and
  // app/order/actions.ts, which treat a kit line like a discountEligible:false one).
  price       Decimal  @db.Decimal(10, 2)
  images      String[]
  isActive    Boolean  @default(true)
  items       KitItem[]
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KitItem {
  id              Int           @id @default(autoincrement())
  kitId           Int
  kit             Kit           @relation(fields: [kitId], references: [id], onDelete: Cascade)
  onecStockItemId Int
  onecStockItem   OnecStockItem @relation(fields: [onecStockItemId], references: [id])
  // Required quantity locked into the bundle — the cart floor for this item;
  // see CartContext's addKit. Same unit as a normal cart line (packs for
  // pack-sold items, pieces otherwise — matches CartItem.qty).
  qty             Int
  sortOrder       Int           @default(0)

  @@unique([kitId, onecStockItemId])
  @@index([onecStockItemId])
}

// ─── 1C exchange — catalog source of truth for storefront + admin ────────────

model OnecStockItem {
  id              Int      @id @default(autoincrement())
  onecId          String   @unique // 1C "Ид" — "ТоварGUID#ХарактеристикаGUID" when 1C uses characteristics, else bare GUID
  article         String?
  name            String
  barcode         String?
  brand           String?          // Изготовитель
  countryOfOrigin String?
  description     String?
  groupName       String?          // raw 1C classifier leaf group name — plain text, quick display only; real hierarchy is OnecCategory via categoryId
  categoryId      Int?
  category        OnecCategory? @relation(fields: [categoryId], references: [id])
  stock           Int      @default(0)
  pricePerPc      Decimal  @default(0) @db.Decimal(10, 2)
  imageUrl        String?          // linked post-sync by scripts/link-onec-images.ts, matched by article to Supabase Storage
  images          String[]
  isNew           Boolean  @default(false) // true when first inserted by sync; admin clears after review
  slug            String?  @unique // nullable indefinitely — generated on insert (lib/onecImport.ts), backfilled once by scripts/backfill-onec-slugs.ts; never regenerated on update so live URLs don't churn
  packQty         Int?     // количество шаров в упаковке — 1C doesn't send this, hand-curated per brand; backfilled from StockItem, never overwritten by sync (see upsertProductChunk)
  sizeInches      String?  // same as above: StockItem-only enrichment, backfilled once
  occasion        String?  // Праздник — 1C doesn't send this, backfilled from Donballon xlsx export, hand-curated, never touched by lib/onecImport.ts sync
  shade           String?  // Оттенок
  color           String?  // Цвет
  colorGroup      String?  // Группа цвета
  lengthMm        Int?     // Длина (мм)
  widthMm         Int?     // Ширина (мм)
  heightMm        Int?     // Высота (мм)
  baseUnit        String?  // Базовая единица — donballon xlsx export ("шт"/"упак"), hand-curated, never touched by lib/onecImport.ts sync
  weightGrams     Int?     // Вес (грамм) — donballon xlsx export, same as above
  onSale          Boolean  @default(false) // manual storefront discount toggle, backfilled from StockItem — never set by 1C sync
  salePercent     Int?
  isNewPending    Boolean  @default(false) // "Ожидайте поступления" — pre-arrival novelty (admin-created or donballon-novelties agent), never touched by 1C sync
  stockOverride   Boolean  @default(false) // true = admin manually set stock; lib/onecImport.ts's updateOfferChunk skips this column on future syncs
  priceOverride   Boolean  @default(false) // true = admin manually set price; same skip behavior as stockOverride
  isHidden        Boolean  @default(false) // admin permanently hides this row from the storefront (e.g. an unwanted 1C offer variant); survives 1C sync — never written by lib/onecImport.ts, filtered out of every public read path in lib/onecStock.ts
  isHit           Boolean  @default(false) // "Хит продаж" — bootstrapped from donballon.ru's storefront badge (their B2B export has no such column), later from our own weekly sales aggregation; hand-curated, never touched by 1C sync
  reorderQtyOverride Int?  // admin-set "Купить, шт" in the Дозаказ report — null means use the calculated value (lib/reorderReport.ts); never touched by 1C sync
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  likes           Like[]
  stockSnapshots  StockSnapshot[]
  kitItems        KitItem[]

  @@index([article])
  @@index([barcode])
  @@index([isNew])
  @@index([isNewPending])
  @@index([isHit])
  @@index([categoryId])
}

// Daily point-in-time copy of OnecStockItem.stock. 1C stock is
// channel-agnostic (updated ~2-3x/day regardless of whether a sale happened
// on the site or offline/in-1C — see SyncLog source "1c-offers"), so
// day-over-day drops here are used as a proxy for real consumption when
// computing reorder recommendations (lib/reorderReport.ts). Written by
// scripts/snapshot-stock.ts, pruned to the last 60 days by the same script.
model StockSnapshot {
  id              Int           @id @default(autoincrement())
  onecStockItemId Int
  onecStockItem   OnecStockItem @relation(fields: [onecStockItemId], references: [id], onDelete: Cascade)
  stock           Int
  capturedAt      DateTime      @default(now())

  @@index([onecStockItemId, capturedAt])
}

// Mirrors 1C's Классификатор group tree (arbitrary depth) — isolated from the
// live storefront Category model; feeds only the admin "Дерево 1С" browse view.
model OnecCategory {
  id        Int             @id @default(autoincrement())
  onecId    String          @unique // 1C "Группа" Ид (GUID), any depth
  name      String
  slug      String?         @unique // nullable indefinitely, same rationale as OnecStockItem.slug
  parentId  Int?
  parent    OnecCategory?   @relation("OnecCategoryTree", fields: [parentId], references: [id])
  children  OnecCategory[]  @relation("OnecCategoryTree")
  items     OnecStockItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([parentId])
}

model SyncLog {
  id        Int      @id @default(autoincrement())
  source    String   // "1c-catalog" | "1c-offers"
  status    String   // "success" | "failure"
  created   Int      @default(0)
  updated   Int      @default(0)
  skipped   Int      @default(0)
  message   String?
  createdAt DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}

// One row per shopper-initiated catalog search (a /catalog?q=... page view —
// not every autocomplete keystroke, which would flood this table). Written by
// lib/searchAnalytics.ts's logSearch(), called from CatalogView. Powers the
// admin "Поиск" tab: popular queries and, especially, zero-result queries
// (what people typed that the catalog couldn't answer).
model SearchEvent {
  id              Int      @id @default(autoincrement())
  query           String   // as typed
  normalizedQuery String   // lowercased/trimmed — the grouping key for reports
  resultCount     Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([normalizedQuery])
  @@index([createdAt])
  @@index([resultCount])
}

// One row per click on a product that happened while a search query was
// active — either an autocomplete suggestion (source "suggest") or a card in
// the /catalog?q=... results grid (source "catalog"). Written by
// lib/searchAnalytics.ts's logSearchClick(), fired from the client via
// /api/search/track-click. Correlated to SearchEvent by normalizedQuery, not
// a foreign key — a search "view" and its later click are two independent,
// best-effort beacons, not one transaction.
model SearchClickEvent {
  id              Int      @id @default(autoincrement())
  query           String
  normalizedQuery String
  itemId          Int
  source          String   // "suggest" | "catalog"
  createdAt       DateTime @default(now())

  @@index([normalizedQuery])
  @@index([itemId])
  @@index([createdAt])
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  text      String
  rating    Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}
